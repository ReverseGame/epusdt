app_name=epusdt
#下面配置你的域名，收银台会需要
app_uri=https://dujiaoka.com
#是否开启debug，默认false
app_debug=false
#http服务监听端口
http_listen=:8000

#静态资源文件目录
static_path=/static
#缓存路径
runtime_root_path=/runtime

#日志配置
log_save_path=/logs
log_max_size=32
log_max_age=7
max_backups=3

# mysql配置
mysql_host=127.0.0.1
mysql_port=3306
mysql_user=mysql账号
mysql_passwd=mysql密码
mysql_database=数据库
mysql_table_prefix=
mysql_max_idle_conns=10
mysql_max_open_conns=100
mysql_max_life_time=6

# redis配置
redis_host=127.0.0.1
redis_port=6379
redis_passwd=
redis_db=5
redis_pool_size=5
redis_max_retries=3
redis_idle_timeout=1000

# 消息队列配置
queue_concurrency=10
queue_level_critical=6
queue_level_default=3
queue_level_low=1

#机器人Apitoken
tg_bot_token=
#telegram代理url(大陆地区服务器可使用一台国外服务器做反代tg的url)，如果运行的本来就是境外服务器，则无需填写
tg_proxy=
#管理员userid
tg_manage=

#api接口认证token
api_auth_token=

#订单过期时间(单位分钟)
order_expiration_time=10

#强制汇率(设置此参数后每笔交易将按照此汇率计算，例如:6.4)
forced_usdt_rate=

# USDT-TRC独立收入核对（默认关闭，不影响原订单付款匹配）
# 先执行sql/20261109-incoming-transfer-event.sql；支持true/false，也支持1/0。
income_audit_enabled=false
# 必填：扫描起点，Unix毫秒时间戳；设为希望开始核对的时间，不默认扫描全部历史。
income_audit_start_ms=0
# 必填：本业务白名单TRON钱包，多个以英文逗号分隔；与ipOasis侧白名单一致。
income_audit_wallets=
# 每轮时间窗毫秒，默认3600000，上限3600000；有5分钟以内重叠以补齐迟到索引。
income_audit_window_ms=3600000
# 分别用于TronScan索引查询与TronGrid固化回执查询，不可混用。
income_audit_tronscan_key=
income_audit_trongrid_key=
# 必填：可访问的HTTPS接收地址，路径为/internal/payment/unmatched-income。
income_audit_notify_url=
# 必填：至少32字符，与ipOasis income-anomaly.secret保持一致，禁止提交真实值。
income_audit_secret=
# 同一交易+钱包整组投递失败最多8轮，随后FAILED停止自动重试，reason保存最后错误。
# 排查并修正原因后，按文档重置该组，不能把支付订单改成已付款。
